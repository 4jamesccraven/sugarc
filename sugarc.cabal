cabal-version:      3.0
name:               sugarc
version:            0.1.0.0

license:            GPL-3.0-or-later
license-file:       LICENSE
author:             4jamesccraven
maintainer:         4jamesccraven@gmail.com
build-type:         Simple
extra-doc-files:    README.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  SugarCane.Farm SugarCane.Geometry
    build-depends:    base ^>=4.20.2.0
    hs-source-dirs:   src
    default-language: GHC2024

executable sugarc
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base ^>=4.20.2.0,
        sugarc

    hs-source-dirs:   app

    default-language: GHC2024

test-suite sugarc-test
    import:           warnings

    default-language: GHC2024
    type:             exitcode-stdio-1.0

    hs-source-dirs:   test

    main-is:          Main.hs

    build-depends:
        base ^>=4.20.2.0,
        sugarc
